import wollok.game.*
import gatito.*
import juego.*
import lago.*
import nivel.*
import ovillo.*
import pescadito.*
import puente.*
import sonido.*
import tramo.*
// wollok run "src.juego.carreraDeGatitos" --port 4200 -p "." -a "assets"


program carreraDeGatitos {
    game.width(100)
    // 71 filas para el mapa y 5 más arriba para la barra
    game.height(76)
    game.cellSize(20)
    game.title("Carrera de gatitos")

    juego.iniciar()

    game.addVisualCharacter(gatito)
    game.onTick(1000, "moverPuente", {
        juego.moverPuentes()
    })


    // Movimiento hacia arriba
    keyboard.up().whilePressedDo({
        gatito.position(gatito.position().up(1))
    }, 100)

    // Movimiento hacia abajo
    keyboard.down().whilePressedDo({
        gatito.position(gatito.position().down(1))
    }, 100)

    // Movimiento hacia la izquierda
    keyboard.left().whilePressedDo({
        gatito.position(gatito.position().left(1))
    }, 100)

    // Movimiento hacia la derecha
    keyboard.right().whilePressedDo({
        gatito.position(gatito.position().right(1))
    }, 100)

    game.start()
}