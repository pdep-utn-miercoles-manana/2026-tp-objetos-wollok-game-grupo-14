object lagoNivel1 {
    method zonaPeligrosa(posicion) {
        return posicion.x() >=51 && posicion.x() <=61 && posicion.y() == 51
    }
    method afectarGatito() {
        if(self.zonaPeligrosa(gatito.position()) && !puenteNivel1.estaSobreElLago(gatito.position())) {
        game.say(gatito, "Perdí!!")
        }
    }
}

object puenteNivel1 {
    var posicionY = 46
    var subiendo = true

    method position() = game.at(53, posicionY)

    method position(nuevaPosicion) {
        posicionY = nuevaPosicion.y()
    }

    method image() = "puenteGrande.png"

    method mover() {
        if (subiendo) {
            posicionY += 1
        }
        else {
            posicionY -= 1
        }

        if (posicionY >= 51) {
            subiendo = false
        }
        if (posicionY <= 46) {
            subiendo = true
        }
    }

    method estaSobreElLago(posicion) {
        return posicion.x() >= 51 &&
            posicion.x() <= 61 &&
            posicion.y() == 51 &&
            posicionY >= 49 &&
            posicionY <= 51    
    }
}